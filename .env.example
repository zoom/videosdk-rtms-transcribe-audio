# Do not expose your credentials to the client, when using the Video SDK in production please make sure to use a backend service to sign the tokens. Don't store credentials in plain text, as this is a sample app we're using an `.env` for sake of simplicity.

# Your Zoom SDK Key (required)
ZM_RTMS_CLIENT=
# Your Zoom SDK Secret (required)
ZM_RTMS_SECRET=

# Your Zoom webhook secret token (required for endpoint validation)
ZOOM_SECRET_TOKEN=
# Zoom AI Services API key and secret (server-side only); signs a fresh JWT per stream
ZOOM_API_KEY=
ZOOM_API_SECRET=
# Alternatively, supply an API key bearer token or pre-generated JWT with Scribe Live access
# If set, this overrides ZOOM_API_KEY and ZOOM_API_SECRET
ZOOM_ACCESS_TOKEN=

# Backend port, also used by the browser token request (defaults to 3000 when omitted)
VITE_PORT=4000
